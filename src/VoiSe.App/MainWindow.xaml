                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                    <GradientStop Color="#FF22C55E" Offset="0" />
                                                                    <GradientStop Color="#FF22C55E" Offset="0.78" />
                                                                    <GradientStop Color="#FFFACC15" Offset="0.90" />
                                                                    <GradientStop Color="#FFEF4444" Offset="1" />
                                                                </LinearGradientBrush>
