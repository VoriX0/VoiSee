                                                            Width="38"
                                                            Height="300"
                                                            IsHitTestVisible="False">
                                                        <TextBlock Text="100 MAX" FontSize="9" Canvas.Left="4" Canvas.Top="-6" />
                                                        <TextBlock Text="75" FontSize="10" Canvas.Left="4" Canvas.Top="68" />
                                                        <TextBlock Text="50" FontSize="10" Canvas.Left="4" Canvas.Top="143" />
                                                        <TextBlock Text="25" FontSize="10" Canvas.Left="4" Canvas.Top="218" />
                                                        <TextBlock Text="0" FontSize="10" Canvas.Left="4" Canvas.Top="286" />
                                                    </Canvas>
