                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="To Mic"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />

                                                <Grid Grid.Row="1"
                                                      Width="50"
                                                      Height="300"
