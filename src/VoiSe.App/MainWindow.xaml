                                                            <Rectangle Width="12" Height="1" Fill="#65FFFFFF" Canvas.Top="0" />
                                                            <Rectangle Width="12" Height="1" Fill="#55FFFFFF" Canvas.Top="75" />
                                                            <Rectangle Width="12" Height="1" Fill="#45FFFFFF" Canvas.Top="150" />
                                                            <Rectangle Width="12" Height="1" Fill="#35FFFFFF" Canvas.Top="225" />
                                                            <Rectangle Width="12" Height="1" Fill="#25FFFFFF" Canvas.Top="299" />
