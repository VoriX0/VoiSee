<Window
    x:Class="VoiSe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoiSe.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VoiSee 14.7.1">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource VoiSee.AppBackgroundBrush}" SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar" Grid.Row="0" Background="{ThemeResource VoiSee.TitleBarBackgroundBrush}" Height="32" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="ms-appx:///Assets/AppIcon_24.png" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarVersionTextBlock" Text="VoiSee 14.7.1" FontSize="12" Foreground="{ThemeResource VoiSee.PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Style="{ThemeResource VoiSee.Style.Panel.MainHeader}" x:Name="MainHeaderBorder" Grid.Row="0" Padding="6" MinHeight="46">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon_48.png" Width="34" Height="34" VerticalAlignment="Center" />
                    <TextBlock x:Name="MainTitle" Text="VoiSee 14.7.1" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource VoiSee.PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{local:Localize Key=Mic_Output_6515fd5f}" Foreground="{ThemeResource VoiSee.PrimaryTextBrush}" Opacity="0.62" VerticalAlignment="Center" />
                    <TextBlock x:Name="VirtualMicMuteStatusTextBlock" Text="{local:Localize Key=Live_b64ac05f}" Foreground="{ThemeResource VoiSee.SuccessBrush}" Opacity="0.95" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{ThemeResource VoiSee.Style.Button.VirtualMicMute}" x:Name="VirtualMicMuteToggleButton" Content="{local:Localize Key=Mute_8dd6857b}" MinWidth="92" Padding="10,4" Click="OnVirtualMicMuteToggleClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="MainContentHost" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="VirtualMicMutedBanner" Grid.Row="0" Background="{ThemeResource VoiSee.MuteBannerBackgroundBrush}" BorderBrush="{ThemeResource VoiSee.MuteBannerBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}" Padding="12,8" Visibility="Collapsed">
                <TextBlock Text="{local:Localize Key=Virtual_mic_output_is_muted_You_can_still_hear_14d300fa}" Foreground="{ThemeResource VoiSee.PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
            </Border>
            <Border x:Name="MainTabHostBorder" Grid.Row="1" Padding="4">
                <TabView x:Name="MainTabView" IsAddTabButtonVisible="False" TabWidthMode="Equal" RequestedTheme="Dark" SelectionChanged="OnMainTabViewSelectionChanged">
                <TabViewItem Header="{local:Localize Key=SoundBoard_b5e1e6b0}" IsClosable="False">
                    <Grid x:Name="SoundBoardTabRoot" Background="Transparent" Padding="0,16,0,0" RowSpacing="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowDrop="True" DragOver="OnSoundBoardDragOver" DragLeave="OnSoundBoardDragLeave" Drop="OnSoundBoardDrop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- HEAD -->
                        <Border Grid.Row="0" Padding="6">
                            <Grid ColumnSpacing="8" MinHeight="124">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="104" />
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="1" Padding="0" Width="164" Height="104" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid RowSpacing="8" ColumnSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="48" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{ThemeResource VoiSee.Style.Button.SoundBoardTransport}" Grid.Row="0" Grid.Column="0" x:Name="PreviousSoundButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="18" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnPreviousSoundClick" ToolTipService.ToolTip="{local:Localize Key=Previous_track_c50a886d}" />
                                        <Button Style="{ThemeResource VoiSee.Style.Button.SoundBoardTransport}" Grid.Row="0" Grid.Column="1" x:Name="NextSoundButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="18" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnNextSoundClick" ToolTipService.ToolTip="{local:Localize Key=Next_track_f930a5df}" />
                                        <ToggleButton Style="{ThemeResource VoiSee.Style.ToggleButton}" Grid.Row="1" Grid.Column="0" x:Name="SoundLoopToggleButton" Content="∞" FontSize="20" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Checked="OnSoundLoopToggleChanged" Unchecked="OnSoundLoopToggleChanged" ToolTipService.ToolTip="{local:Localize Key=Loop_current_SoundBoard_track_8f2c778f}" />
                                        <Button Style="{ThemeResource VoiSee.Style.Button.SoundBoardTransport}" Grid.Row="1" Grid.Column="1" x:Name="StopSoundButton" Content="{local:Localize Key=Stop_cae7d57b}" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnStopSoundClick" ToolTipService.ToolTip="{local:Localize Key=Stop_sound_c1374efe}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Padding="2">
                                    <TextBlock Style="{ThemeResource VoiSee.Style.Text.Secondary}" x:Name="TransportStatusTextBlock" Text="{local:Localize Key=No_sound_0c08def0}" HorizontalAlignment="Center" Opacity="0.75" />
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="0" Height="104" VerticalAlignment="Top">
                                    <Grid Height="104" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="76" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>

                                        <Button Style="{ThemeResource VoiSee.Style.Button.SoundBoardTransport}" Grid.Row="0" Grid.Column="0" x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="22" MinWidth="0" Width="56" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnPlayPauseSoundClick" ToolTipService.ToolTip="{local:Localize Key=Play_Pause_6f97fb8c}">
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="10" />
                                            </Button.RenderTransform>
                                        </Button>

                                        <Grid Grid.Row="0" Grid.Column="1" x:Name="TimelineHost" Height="48" VerticalAlignment="Center" Background="{ThemeResource VoiSee.TimelineHostBrush}" PointerPressed="OnTimelineHostPointerPressed" PointerMoved="OnTimelineHostPointerMoved" PointerReleased="OnTimelineHostPointerReleased" PointerCanceled="OnTimelineHostPointerReleased" SizeChanged="OnTimelineHostSizeChanged">
                                            <Grid.RenderTransform>
                                                <TranslateTransform Y="10" />
                                            </Grid.RenderTransform>
                                            <Grid Height="8" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource VoiSee.TimelineTrackBrush}" CornerRadius="{ThemeResource VoiSee.CornerRadius.Small}" />
                                                <Border x:Name="TimelineFill" Width="0" HorizontalAlignment="Left" Background="{ThemeResource VoiSee.TimelineFillBrush}" CornerRadius="{ThemeResource VoiSee.CornerRadius.Small}" />
                                            </Grid>
                                            <Ellipse x:Name="TimelineThumb" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{ThemeResource VoiSee.TimelineThumbBrush}">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="TimelineThumbTransform" X="0" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CurrentTimeTextBlock" Text="00:00" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="2" x:Name="TotalTimeTextBlock" Text="00:00" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Padding="6">
                                    <StackPanel Spacing="6" VerticalAlignment="Top">
                                        <TextBlock x:Name="SoundVirtualVolumeLabel" Text="{local:Localize Key=SoundBoard_Virtual_Mic_100_40e073b4}" FontWeight="SemiBold" />
                                        <Slider Style="{ThemeResource VoiSee.Style.Slider}" x:Name="SoundVirtualVolumeSlider" Minimum="0" Maximum="1.5" Value="1" StepFrequency="0.01" ValueChanged="OnSoundVolumeChanged" />
                                        <TextBlock x:Name="SoundMonitorVolumeLabel" Text="{local:Localize Key=SoundBoard_Headphones_100_a6674dd3}" FontWeight="SemiBold" />
                                        <Slider Style="{ThemeResource VoiSee.Style.Slider}" x:Name="SoundMonitorVolumeSlider" Minimum="0" Maximum="1.5" Value="1" StepFrequency="0.01" ValueChanged="OnSoundVolumeChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- BODY -->
                        <Border Grid.Row="1" Padding="6">
                            <Grid x:Name="SoundBoardBodyGrid" ColumnSpacing="0" Background="Transparent" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="78*" />
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: categories and category info panel -->
                                <Grid Grid.Column="0" RowSpacing="8" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{ThemeResource VoiSee.Style.Button}" Grid.Column="0" Content="{local:Localize Key=Create_4759498a}" HorizontalAlignment="Stretch" Click="OnAddCategoryClick" />
                                        <Button Style="{ThemeResource VoiSee.Style.Button}" Grid.Column="1" Content="{local:Localize Key=Rename_3064d79a}" HorizontalAlignment="Stretch" Click="OnRenameCategoryClick" />
                                        <Button Style="{ThemeResource VoiSee.Style.Button}" Grid.Column="2" Content="{local:Localize Key=Delete_e2d0a549}" HorizontalAlignment="Stretch" Click="OnDeleteCategoryClick" />
                                    </Grid>
                                    <ComboBox Style="{ThemeResource VoiSee.Style.ComboBox}" Grid.Row="1"
                                              x:Name="CategoryComboBox"
                                              PlaceholderText="{local:Localize Key=Choose_category_1eb0412b}"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="OnCategorySelectionChanged"
                                              HorizontalAlignment="Stretch" />

                                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" Background="{ThemeResource VoiSee.PanelBackgroundBrush}" BorderBrush="{ThemeResource VoiSee.PanelBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Style="{ThemeResource VoiSee.Style.Text.Secondary}" x:Name="CategoryInfoTextBlock"
                                                   Text="{local:Localize Key=Categories_0_Tracks_in_category_0_Category_use_b07d57db}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.82" />
                                    </Border>
                                </Grid>

                                <!-- RIGHT: header, search/actions, then scrollable sound list -->
                                <Grid Grid.Column="2" RowSpacing="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{local:Localize Key=Sounds_6f305c4b}" FontSize="18" FontWeight="SemiBold" />

                                    <Grid Grid.Row="1" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                            <TextBox Style="{ThemeResource VoiSee.Style.TextBox}" x:Name="TrackSearchTextBox"
                                                     Width="360"
                                                     PlaceholderText="{local:Localize Key=Search_track_07345689}"
                                                     KeyDown="OnTrackSearchKeyDown" />
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Content="{local:Localize Key=Find_822b2ae4}" Click="OnSearchTrackClick" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Content="{local:Localize Key=Add_Track_c7c2e6a1}" Click="OnAddSoundClick" />
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Content="{local:Localize Key=Delete_Track_3bf93739}" Click="OnDeleteSoundClick" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            x:Name="SoundListArea"
                                            Background="Transparent"
                                            Padding="0"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch">
                                        <Grid Background="Transparent">
                                            <!-- 12.3.3: SoundBoard sounds are owned and scrolled directly by ListView. -->
                                            <ListView x:Name="SoundItemsListView"
                                                      Style="{ThemeResource VoiSee.Style.ListView}"
                                                      ItemContainerStyle="{ThemeResource VoiSee.Style.ListViewItem}"
                                                      SelectionMode="None"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollMode="Enabled"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                                      HorizontalContentAlignment="Stretch"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      Padding="0,0,48,8"
                                                      AllowDrop="True"
                                                      DragOver="OnSoundBoardDragOver"
                                                      DragLeave="OnSoundBoardDragLeave"
                                                      Drop="OnSoundBoardDrop" />
                                            <ScrollViewer x:Name="SoundOverlayScrollViewer" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.RowSpan="2"
                                x:Name="SoundBoardSceneLockOverlay"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="18,12"
                                CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                Background="{ThemeResource VoiSee.DropOverlayInnerBackgroundBrush}"
                                BorderBrush="{ThemeResource VoiSee.DropOverlayInnerBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{local:Localize Key=SoundBoard_playback_is_unavailable_while_a_sce_dabc7d53}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Name="VoiceChangerTab" Header="{local:Localize Key=Voice_Changer_0fab9f61}" IsClosable="False">
                    <!-- 12.3.3 buildfix 2: collection controls own their native scrolling; effect library items are generated in code. -->
                    <Grid x:Name="VoiceChangerStudioRoot" Padding="0,16,32,22" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" MinWidth="500" />
                                <ColumnDefinition Width="470" />
                            </Grid.ColumnDefinitions>

                            <!-- Voice presets fill the left column; microphone cleanup lives on the equalizer tab. -->
                            <Grid Grid.Column="0" x:Name="VoiceChangerLeftColumn" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>



                                <Border Grid.Row="1" x:Name="VoicePresetSurface" Padding="12" MinHeight="0"
                                        CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                        Background="{ThemeResource VoiSee.PanelBackgroundBrush}"
                                        BorderBrush="{ThemeResource VoiSee.PanelBorderBrush}" BorderThickness="1">
                                    <Grid RowSpacing="9">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="☷" FontSize="15" Opacity="0.7" />
                                                <TextBlock Text="{local:Localize Key=Presets_954f93fe}" FontSize="17" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Content="{local:Localize Key=New_af6aa8e6}" Height="32" Padding="9,3"
                                                    HorizontalAlignment="Right" Click="OnNewVoicePresetClick" />
                                        </Grid>
                                        <TextBox Style="{ThemeResource VoiSee.Style.TextBox}" Grid.Row="1"
                                                 x:Name="VoicePresetSearchBox" PlaceholderText="{local:Localize Key=Search_presets_7c2d7bbd}"
                                                 TextChanged="OnVoicePresetSearchTextChanged" />
                                        <ListView Grid.Row="2" x:Name="VoicePresetsListView"
                                                  Style="{ThemeResource VoiSee.Style.ListView}"
                                                  ItemContainerStyle="{ThemeResource VoiSee.Style.ListViewItem}"
                                                  SelectionMode="None"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollMode="Enabled"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                                  HorizontalContentAlignment="Stretch"
                                                  Padding="0,1,2,1" />
                                        <StackPanel x:Name="VoicePresetsPanel" Visibility="Collapsed" />
                                        <Grid Grid.Row="3" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Content="{local:Localize Key=Import_2cff9baa}" Height="38" HorizontalAlignment="Stretch" Click="OnImportVoicePresetClick" />
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" Grid.Column="1" Content="{local:Localize Key=Folder_74ccd433}" Height="38" HorizontalAlignment="Stretch" Click="OnOpenVoicePresetsFolderClick" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- CENTER: the processing content panel is directly wrapped by its ScrollViewer. -->
                            <Border Grid.Column="1" x:Name="ProcessingChainSurface" Padding="12,10"
                                    CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                    Background="{ThemeResource VoiSee.PanelBackgroundBrush}"
                                    BorderBrush="{ThemeResource VoiSee.PanelBorderBrush}" BorderThickness="1"
                                    AllowDrop="True" DragOver="OnEffectChainDragOver" Drop="OnEffectChainDrop">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{ThemeResource VoiSee.Style.Button}" x:Name="VoiceMonitorButton"
                                                Content="{local:Localize Key=Voice_Monitor_Off_f0b11e44}" Height="36" MinWidth="156" Click="OnToggleVoiceMonitorClick" />
                                        <Border Grid.Column="1" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="12" Background="{ThemeResource VoiSee.CardValueBackgroundBrush}">
                                            <TextBlock x:Name="EffectChainSummaryText" Text="{local:Localize Key=0_active_effects_e27fcf33}" FontSize="10.5" Opacity="0.78" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" x:Name="BypassEffectChainButton"
                                                    Content="{local:Localize Key=Bypass_All_17060eb6}" Height="36" MinWidth="92" Click="OnBypassEffectChainClick" />
                                            <Button Style="{ThemeResource VoiSee.Style.Button}" x:Name="ClearEffectChainButton"
                                                    Content="{local:Localize Key=Clear_Chain_a740527f}" Height="36" MinWidth="92" Click="OnClearEffectChainClick" />
                                        </StackPanel>
                                    </Grid>

                                    <ScrollView Grid.Row="1" x:Name="ProcessingChainScrollView"
                                                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                                HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                                                ZoomMode="Disabled" HorizontalContentAlignment="Stretch"
                                                VerticalScrollChainMode="Never">
                                        <StackPanel x:Name="ProcessingChainContentPanel" HorizontalAlignment="Stretch" Spacing="0" Padding="8,4,10,8">
                                            <Border Width="230" Height="58" HorizontalAlignment="Center" Padding="12,7"
                                                    CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                                    Background="{ThemeResource VoiSee.CardValueBackgroundBrush}"
                                                    BorderBrush="{ThemeResource VoiSee.CardValueBorderBrush}" BorderThickness="1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🎙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{local:Localize Key=Microphone_In_f7bbb9fb}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{local:Localize Key=Physical_microphone_preprocessed_9a5e09e1}" FontSize="9.5" Opacity="0.54" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Rectangle Width="2" Height="12" Fill="{ThemeResource VoiSee.PanelBorderBrush}" Opacity="0.68" HorizontalAlignment="Center" />

                                            <StackPanel x:Name="EffectChainCardsPanel" Orientation="Vertical" Spacing="0" HorizontalAlignment="Stretch"
                                                        AllowDrop="True" DragOver="OnEffectChainDragOver" Drop="OnEffectChainDrop" />

                                            <Border x:Name="EffectPreviewHost" Visibility="Collapsed" MinHeight="52" Margin="18,5"
                                                    Padding="12,8" CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                                    Background="#10FFFFFF" BorderBrush="{ThemeResource VoiSee.PanelBorderBrush}"
                                                    BorderThickness="1" Opacity="0.80" />

                                            <Rectangle Width="2" Height="8" Fill="{ThemeResource VoiSee.PanelBorderBrush}" Opacity="0.68" HorizontalAlignment="Center" />
                                            <Border x:Name="EffectChainDropZone" Width="160" Height="16" CornerRadius="8"
                                                    Background="{ThemeResource VoiSee.CardValueBackgroundBrush}"
                                                    BorderBrush="{ThemeResource VoiSee.PanelBorderBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" AllowDrop="True" DragOver="OnEffectChainDragOver" Drop="OnEffectChainDrop">
                                                <Rectangle Height="1" Margin="18,0" VerticalAlignment="Center" Fill="{ThemeResource VoiSee.PrimaryTextBrush}" Opacity="0.25" />
                                            </Border>
                                            <Rectangle Width="2" Height="10" Fill="{ThemeResource VoiSee.PanelBorderBrush}" Opacity="0.68" HorizontalAlignment="Center" />
                                            <Border Width="250" Height="60" HorizontalAlignment="Center" Padding="12,7"
                                                    CornerRadius="{ThemeResource VoiSee.CornerRadius.Medium}"
                                                    Background="{ThemeResource VoiSee.CardValueBackgroundBrush}"
                                                    BorderBrush="{ThemeResource VoiSee.CardValueBorderBrush}" BorderThickness="1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🎧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{local:Localize Key=Output_Monitor_fc303ff5}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{local:Localize Key=Processed_voice_to_Virtual_Mic_bfc48361}" FontSize="9.5" Opacity="0.54" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollView>
                                    <ScrollViewer x:Name="ProcessingChainScrollViewer" Grid.Row="1" Visibility="Collapsed" />
                                </Grid>
                            </Border>

